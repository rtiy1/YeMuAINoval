FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
WORKDIR /app

COPY LICENSE ./LICENSE
COPY ai-service/requirements.txt ai-service/requirements.lock ./ai-service/
RUN pip install --no-cache-dir -r ai-service/requirements.lock
COPY ai-service ./ai-service
COPY skills ./skills

EXPOSE 8890
CMD ["python", "-m", "uvicorn", "app.main:app", "--app-dir", "ai-service", "--host", "0.0.0.0", "--port", "8890"]
