{
  "name": "oh-story-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node --env-file-if-exists=.env server/index.mjs",
    "dev:ai": "node server/ai-task.mjs dev",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "npm run test:api && npm run test:ai && npm run test:integration",
    "test:api": "node server/smoke-test.mjs",
    "test:ai": "node server/ai-task.mjs test",
    "test:integration": "node server/ai-gateway-test.mjs",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "cookie-parser": "latest",
    "cors": "latest",
    "express": "latest",
    "express-rate-limit": "latest",
    "helmet": "latest",
    "jose": "latest",
    "lucide-react": "latest",
    "vite": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {}
}
