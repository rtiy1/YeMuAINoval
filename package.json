{
  "name": "oh-story-web",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node --env-file-if-exists=.env server/index.mjs",
    "dev:ai": "node server/ai-task.mjs dev",
    "dev:worker": "node --env-file-if-exists=.env server/ai-worker.mjs",
    "novel": "node --env-file-if-exists=.env terminal/novel-agent.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "npm run test:unit && npm run test:api && npm run test:ai && npm run test:integration",
    "test:unit": "node --test server/edit-proposal-test.mjs server/editor-agent-test.mjs server/agent-thread-test.mjs server/sse-test.mjs server/chat-memory-test.mjs server/skill-review-test.mjs terminal/*.test.mjs",
    "test:api": "node server/smoke-test.mjs && node server/registration-mode-test.mjs",
    "test:ai": "node server/ai-task.mjs test",
    "test:integration": "node server/ai-gateway-test.mjs",
    "test:postgres": "bash scripts/test-postgres-compose.sh",
    "db:status": "node server/db-cli.mjs status",
    "db:import-json": "node server/db-cli.mjs import",
    "db:export-json": "node server/db-cli.mjs export",
    "db:backup": "bash scripts/postgres-backup.sh",
    "db:restore": "bash scripts/postgres-restore.sh",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "cookie-parser": "latest",
    "cors": "latest",
    "express": "latest",
    "express-rate-limit": "latest",
    "fflate": "^0.8.3",
    "helmet": "latest",
    "ioredis": "^5.11.1",
    "jose": "latest",
    "lucide-react": "latest",
    "pg": "^8.22.0",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  }
}
