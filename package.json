  "scripts": {
    "dev": "vite",
    "dev:api": "bun server/index.mjs",
    "dev:worker": "bun server/ai-worker.mjs",
    "start": "bun server/index.mjs",
    "build": "vite build",
    "test": "bun run test:unit && bun run test:api",
    "test:unit": "bun test server/*.test.mjs src/*.test.mjs src/*.test.ts",
    "test:api": "bun server/registration-mode-test.mjs && bun server/task-queue-config-test.mjs",
    "check": "tsgo -p tsconfig.app.json --noEmit",
    "preview": "vite preview",
    "db:status": "bun server/db-cli.mjs status",
    "db:import-json": "bun server/db-cli.mjs import",
    "db:export-json": "bun server/db-cli.mjs export",
    "yemu:dev": "bun run dev",
    "yemu:api": "bun run dev:api",
    "yemu:worker": "bun run dev:worker",
    "yemu:build": "bun run build",
    "yemu:test": "bun run test",
    "core:dev": "bun --cwd=packages/coding-agent src/cli.ts",
    "core:test": "bun scripts/ci-test-ts.ts local",
    "core:test:ts": "bun scripts/ci-test-ts.ts local-ts",
    "core:test:scripts": "bun test scripts/ci-concurrency.test.ts scripts/fix-dts-extensions.test.ts",
    "core:check": "bun run core:check:ts",
    "core:check:ts": "bun run core:check:tools && bun run --workspaces --if-present check",
    "core:check:tools": "biome check . --no-errors-on-unmatched",
    "check:tools": "biome check . --no-errors-on-unmatched",
    "core:gen:models": "bun --cwd=packages/catalog run gen:models",
    "core:gen:tool-views": "bun --cwd=packages/collab-web run gen:tool-views",
    "core:gen:bundle": "bun --cwd=packages/coding-agent run gen:bundle"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native-preview": "catalog:",
    "lint-staged": "catalog:",
