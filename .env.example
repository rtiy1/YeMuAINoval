AUTH_SECRET=replace-with-at-least-32-random-characters
# Docker Compose 部署配置；deploy.sh 会自动生成缺失的两个密码。
YEMU_PUBLIC_URL=http://127.0.0.1:8787
YEMU_BIND_ADDRESS=127.0.0.1
YEMU_PORT=8787
POSTGRES_DB=yemu
POSTGRES_USER=yemu
POSTGRES_PASSWORD=
DOCKER_REGISTRATION_MODE=closed
DOCKER_SKILL_REVIEW_MODE=required
# Web 构建默认同源访问 /api；仅在前后端跨域部署时填写完整的应用 API 地址。
VITE_API_URL=
# 逗号分隔允许访问 API 的 Web 来源；Codespaces 会自动允许当前工作区的转发端口。
WEB_ORIGIN=http://127.0.0.1:5173
# 邮件里的密码重置链接地址；生产环境请设置为站点的 HTTPS 公网地址。
APP_PUBLIC_URL=http://127.0.0.1:5173
# 生产环境反向代理层数；本地直连保持 false
TRUST_PROXY=false
HOST=127.0.0.1
PORT=8787
# 登录有效期：短期访问令牌默认 60 分钟，刷新会话默认 90 天（刷新时滚动续期）。
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_SESSION_DAYS=90
REFRESH_COOKIE_SECURE=auto
REFRESH_COOKIE_SAME_SITE=lax
# 找回密码链接有效期。生产环境推荐 Resend；本地留空时重置链接会输出到 API 控制台。
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
# 新账号必须通过 6 位邮箱验证码，默认 10 分钟过期；开放注册的生产环境必须配置邮件发送。
EMAIL_VERIFICATION_CODE_TTL_MINUTES=10
# disabled / console / resend；留空时开发环境用 console，生产环境关闭发送。
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM=叙事工坊 <account@example.com>
# Skill 市场安全审查。生产环境保持 required；URL 填完整的 Responses 或 Chat Completions 接口地址。
SKILL_REVIEW_MODE=optional
SKILL_REVIEW_API_URL=
SKILL_REVIEW_API_KEY=
SKILL_REVIEW_MODEL=
SKILL_REVIEW_API_STYLE=responses
SKILL_REVIEW_TIMEOUT_MS=45000
STORY_SKILL_MARKET_DIR=./server/data/skill-market
# 设置后使用 PostgreSQL 关系存储；留空则继续使用 server/data/db.json
DATABASE_URL=
DATABASE_POOL_MAX=10
DATABASE_SSL=false
# 设置后用 Redis 持久化夜雨写作助手聊天记忆；留空则回退到 JSON/Postgres
REDIS_URL=
# 配置 Redis 时默认启用独立 AI worker；队列跨进程执行必须同时配置 DATABASE_URL。
# 只想用 Redis 聊天记忆、仍用 JSON 存储时请设为 false，让 AI 任务留在 API 进程内执行。
AI_TASK_QUEUE_ENABLED=true
AI_TASK_CLAIM_IDLE_MS=180000
AI_TASK_CLAIM_INTERVAL_MS=30000
# AI 成本与滥用保护
AI_DAILY_REQUEST_LIMIT=0
AI_CONCURRENT_REQUEST_LIMIT=3
AI_REQUESTS_PER_MINUTE=30
# false 时用户必须配置自己的模型 Key；本地开发可设 true 使用服务端默认 Key
ALLOW_SHARED_MODEL_KEY=false
# open / owner-only / closed；owner-only 仅允许首位站长注册
REGISTRATION_MODE=open
# 可选：服务端共享模型默认值（也可在设置里按用户配置）。
# 这些凭据只有在 ALLOW_SHARED_MODEL_KEY=true 时才允许回退使用。
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=
# 可选：联网搜索用 Tavily key；留空则自动回退 DuckDuckGo
TAVILY_API_KEY=
