AUTH_SECRET=replace-with-at-least-32-random-characters
# 逗号分隔允许访问 API 的 Web 来源；Codespaces 会自动允许当前工作区的转发端口。
WEB_ORIGIN=http://127.0.0.1:5173
# 生产环境反向代理层数；本地直连保持 false
TRUST_PROXY=false
HOST=127.0.0.1
PORT=8787
AI_SERVICE_URL=http://127.0.0.1:8890
AI_SERVICE_TOKEN=local-ai-service-token
STORY_SKILLS_ROOT=./skills
# 设置后使用 PostgreSQL 关系存储；留空则继续使用 server/data/db.json
DATABASE_URL=
DATABASE_POOL_MAX=10
DATABASE_SSL=false
# 设置后用 Redis 持久化夜雨写作助手聊天记忆；留空则回退到 JSON/Postgres
REDIS_URL=
# 配置 Redis 时默认启用独立 AI worker；设为 false 可在 API 进程内执行（仅建议本地调试）
AI_TASK_QUEUE_ENABLED=true
AI_TASK_CLAIM_IDLE_MS=180000
AI_TASK_CLAIM_INTERVAL_MS=30000
# AI 成本与滥用保护
AI_DAILY_REQUEST_LIMIT=0
AI_CONCURRENT_REQUEST_LIMIT=3
AI_REQUESTS_PER_MINUTE=30
# false 时用户必须配置自己的模型 Key；本地开发可设 true 使用服务端默认 Key
ALLOW_SHARED_MODEL_KEY=false
# open / owner-only / closed；owner-only 仅允许首位站长注册
REGISTRATION_MODE=open
# 可选：Anthropic 服务端默认（也可在设置里按用户配置）
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=
# 可选：联网搜索用 Tavily key；留空则自动回退 DuckDuckGo
TAVILY_API_KEY=
