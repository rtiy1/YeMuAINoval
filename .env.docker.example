AUTH_SECRET=replace-with-a-long-random-secret
POSTGRES_PASSWORD=replace-with-a-long-database-password
POSTGRES_DB=story_studio
POSTGRES_USER=story
AI_SERVICE_TOKEN=replace-with-an-internal-token
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
WEB_ORIGIN=http://localhost:8787
APP_PUBLIC_URL=http://localhost:8787
# owner-only / open 模式必须配置事务邮件；Resend 免费层足够小型站点起步
EMAIL_PROVIDER=resend
RESEND_API_KEY=replace-with-your-resend-api-key
EMAIL_FROM=叙事工坊 <account@your-domain.example>
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_SESSION_DAYS=90
REFRESH_COOKIE_SECURE=auto
REFRESH_COOKIE_SAME_SITE=lax
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
EMAIL_VERIFICATION_CODE_TTL_MINUTES=10
# app 前只有一层反向代理时保持 1；直接暴露 app 时设为 false
TRUST_PROXY=1
APP_PORT=8787
APP_BIND=127.0.0.1
# 修改版应指向该版本完整对应源码的公开仓库
SOURCE_REPOSITORY_URL=https://github.com/rtiy1/YeMuAINoval
REDIS_URL=redis://redis:6379/0
AI_TASK_QUEUE_ENABLED=true
AI_TASK_CLAIM_IDLE_MS=180000
AI_TASK_CLAIM_INTERVAL_MS=30000
AI_DAILY_REQUEST_LIMIT=0
AI_CONCURRENT_REQUEST_LIMIT=3
AI_REQUESTS_PER_MINUTE=30
ALLOW_SHARED_MODEL_KEY=false
REGISTRATION_MODE=owner-only
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=
TAVILY_API_KEY=
