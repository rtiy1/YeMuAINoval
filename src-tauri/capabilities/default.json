{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口默认能力集：窗口控制 + 原生文件夹选择 + 打开外部链接",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "dialog:allow-message",
    "dialog:allow-confirm",
    "opener:allow-open-url"
  ]
}
